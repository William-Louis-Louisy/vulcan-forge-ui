{
  "name": "vulcan-forge-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:up": "docker compose up -d postgres mailpit",
    "dev:down": "docker compose down",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier . --write",
    "format:check": "prettier src/features/components/ComponentAxisDefinitionInspector.tsx src/features/components/ComponentContractWorkspaceContext.test.tsx src/features/components/ComponentContractWorkspaceContext.tsx src/features/components/ComponentPreviewConfigurationBrowser.tsx --write && git diff -- src/features/components/ComponentAxisDefinitionInspector.tsx src/features/components/ComponentContractWorkspaceContext.test.tsx src/features/components/ComponentContractWorkspaceContext.tsx src/features/components/ComponentPreviewConfigurationBrowser.tsx && exit 1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:auth-integration": "vitest run src/server/auth/auth-rate-limit.integration.test.ts src/server/auth/email-verification/email-verification.integration.test.ts src/server/auth/password-recovery/password-recovery.integration.test.ts",
    "audit:ui": "tsx scripts/audit-ui.ts",
    "quality": "npm run db:generate && npm run lint && npm run typecheck && npm run format:check && npm run audit:ui && npm run test && npm run build",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d postgres",
    "db:logs": "docker compose logs -f postgres",
    "mail:up": "docker compose up -d mailpit",
    "mail:logs": "docker compose logs -f mailpit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:push": "prisma db push",
    "db:check": "tsx scripts/check-db.ts"
  },
  "dependencies": {
    "@auth/core": "0.41.3",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "next": "16.2.6",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "^4.11.1",
    "pg": "^8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "^29.1.1",
    "prettier": "3.8.3",
    "prettier-plugin-tailwindcss": "0.8.0",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
