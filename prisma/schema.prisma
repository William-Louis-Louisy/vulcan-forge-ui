// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AppLocale {
  en
  fr
}

enum ThemePreference {
  system
  light
  dark
}

enum WorkspaceRole {
  owner
  admin
  editor
  viewer
}

enum DesignSystemPlatform {
  web
  mobile
}

enum AccessibilityTarget {
  wcag_aa
  wcag_aaa
}

enum TokenSetType {
  color
  spacing
  radius
  typography
  motion
}

enum ThemeMode {
  light
  dark
}

enum ComponentContractType {
  button
  textField
  card
  alert
  dialog
}

enum AccessibilityReportStatus {
  pass
  warning
  fail
}

enum ExportFormat {
  cssVariables
  tailwindV4
  typescriptTheme
  reactNativeTheme
  markdownDocumentation
  aiInstructions
}

enum ExportStatus {
  success
  failed
}

enum BrandVisualStyle {
  minimal
  premium
  editorial
  technical
  playful
  bold
  neutral
  custom
}

enum BrandUiDensity {
  compact
  cozy
  comfortable
}

model DesignSystemProject {
  id                  String                 @id @default(cuid())
  workspaceId         String
  name                String
  slug                String
  description         String?
  platforms           DesignSystemPlatform[] @default([web])
  defaultLocale       AppLocale              @default(en)
  supportedLocales    AppLocale[]            @default([en, fr])
  accessibilityTarget AccessibilityTarget    @default(wcag_aa)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  workspace            Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  localeSettings       ProjectLocaleSettings?
  brandProfile         BrandProfile?
  tokenSets            TokenSet[]
  themes               Theme[]
  componentContracts   ComponentContract[]
  accessibilityReports AccessibilityReport[]
  documentationProfile DocumentationProfile?
  aiInstructionProfile AiInstructionProfile?
  exportLogs            ExportLog[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
  @@index([updatedAt])
  @@map("DesignSystem")
}

model User {
  id              String          @id @default(cuid())
  name            String?
  email           String          @unique
  passwordHash    String
  emailVerifiedAt DateTime?
  imageUrl        String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  preferences            UserPreference?
  memberships            WorkspaceMember[]
  ownedWorkspaces        Workspace[]             @relation("WorkspaceOwner")
  emailVerificationTokens EmailVerificationToken[]
}

model UserPreference {
  id              String          @id @default(cuid())
  userId          String          @unique
  locale          AppLocale       @default(en)
  themePreference ThemePreference @default(system)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner                User                  @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  settings             WorkspaceSettings?
  members              WorkspaceMember[]
  designSystemProjects DesignSystemProject[]
}

model WorkspaceSettings {
  id               String      @id @default(cuid())
  workspaceId      String      @unique
  defaultLocale    AppLocale   @default(en)
  supportedLocales AppLocale[] @default([en, fr])
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  workspace        Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(owner)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model ProjectLocaleSettings {
  id                   String              @id @default(cuid())
  projectId            String              @unique
  defaultLocale        AppLocale           @default(en)
  supportedLocales     AppLocale[]         @default([en, fr])
  documentationLocale  AppLocale           @default(en)
  aiInstructionLocale  AppLocale           @default(en)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  project              DesignSystemProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model BrandProfile {
  id                  String              @id @default(cuid())
  projectId           String              @unique
  visualStyle         BrandVisualStyle    @default(minimal)
  uiDensity           BrandUiDensity      @default(cozy)
  inspirationKeywords String[]            @default([])
  localizedContent    Json
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  project             DesignSystemProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model TokenSet {
  id        String              @id @default(cuid())
  projectId String
  type      TokenSetType
  name      String
  tokens    Json
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  project   DesignSystemProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, type])
  @@index([projectId])
}

model Theme {
  id        String              @id @default(cuid())
  projectId String
  mode      ThemeMode
  name      String
  tokens    Json
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  project   DesignSystemProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, mode])
  @@index([projectId])
}

model ComponentContract {
  id        String                @id @default(cuid())
  projectId String
  type      ComponentContractType
  name      String
  contract  Json
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  project   DesignSystemProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, type])
  @@index([projectId])
}

model DocumentationProfile {
  id        String              @id @default(cuid())
  projectId String              @unique
  format    String              @default("markdown")
  content   Json
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  project   DesignSystemProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model AiInstructionProfile {
  id        String              @id @default(cuid())
  projectId String              @unique
  content   Json
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  project   DesignSystemProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model AccessibilityReport {
  id        String                    @id @default(cuid())
  projectId String
  status    AccessibilityReportStatus
  score     Int
  issues    Json
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt

  project   DesignSystemProject       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  @@index([createdAt])
}

model ExportLog {
  id           String              @id @default(cuid())
  projectId    String
  format       ExportFormat
  locale       AppLocale?
  status       ExportStatus
  errorMessage String?
  createdAt    DateTime            @default(now())

  project      DesignSystemProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([format])
  @@index([status])
  @@index([createdAt])
}

model AuthRateLimitBucket {
  key       String   @id
  attempts  Int      @default(0)
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}
