# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vulcan_forge_ui?schema=public"

# Auth.js
# Generate a high-entropy production value and keep it outside version control.
AUTH_SECRET="replace-with-a-random-production-secret"

# Authentication rate-limit fingerprints
# Use a distinct high-entropy value so account and IP fingerprints cannot be
# correlated with other application secrets. AUTH_SECRET is used only as a
# fallback when this variable is omitted.
AUTH_RATE_LIMIT_SECRET="replace-with-a-distinct-random-secret"

# Forwarded client-address headers are trusted automatically on Vercel because
# Vercel overwrites X-Forwarded-For. Set this to true only when a self-hosted
# reverse proxy is configured to remove spoofed incoming forwarding headers.
AUTH_TRUST_PROXY_HEADERS="false"

# Rate limiting fails closed by default. This emergency override keeps login and
# signup available when rate-limit persistence is unavailable, at the cost of
# temporarily removing abuse protection. Do not enable it as a steady state.
AUTH_RATE_LIMIT_FAIL_OPEN="false"
